# Backend API URL (must include the scheme)
NEXT_PUBLIC_API_BASE=https://your-backend-domain.example.com

# Optional: must match the backend's ADMIN_API_KEY to use the /training page.
# NOTE: NEXT_PUBLIC_* vars are bundled into client-side JS and are visible to
# anyone who views the page source. This only meaningfully protects the admin
# endpoints if you also keep the /training page itself private (e.g. don't
# link it publicly, put it behind your own auth, or restrict it by network).
# For a real deployment, consider moving CSV import behind a proper login
# instead of relying on this key alone.
NEXT_PUBLIC_ADMIN_API_KEY=

# Copy to .env (same directory as docker-compose.yml) and fill in values.
# Never commit the real .env.

# Postgres password used by both the db and backend services.
POSTGRES_PASSWORD=change-me

# Comma-separated origins allowed to call the backend API.
ALLOWED_ORIGINS=http://localhost:3000

# Protects POST /api/admin/retrain and POST /api/admin/training-data/import.
# Strongly recommended once this is reachable from the public internet.
ADMIN_API_KEY=change-me

# The URL your users' BROWSERS will use to reach the backend — baked into
# the frontend's JS bundle at build time. For a single-VPS deploy this is
# usually your domain or public IP on port 8000 (e.g. https://api.example.com
# or http://203.0.113.10:8000), NOT "localhost" unless you're the only user.
NEXT_PUBLIC_API_BASE=http://localhost:8000

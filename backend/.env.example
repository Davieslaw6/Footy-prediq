# Copy to .env and fill in your own values. Never commit the real .env.

DATABASE_URL=postgresql://user:pass@localhost:5432/football_predictor

# Comma-separated frontend origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000

# If set, POST /api/admin/retrain and POST /api/admin/training-data/import
# require this value in an `X-Admin-Key` header. Strongly recommended for
# any deployment reachable from the public internet — these endpoints
# trigger expensive retraining jobs and accept file uploads.
ADMIN_API_KEY=
